<Project>

  <!--
    Properties shared by every project in the repository.
    The target framework stays declared explicitly in each project file.
  -->

  <PropertyGroup Label="Language">
    <!--
      C# 14 is the newest language version net10.0 supports, and the version the SDK
      already selects for this target framework. Pinning it states the intent and keeps
      the build reproducible: "latest" would quietly change with the installed SDK, so
      raise this together with the target framework instead.
    -->
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup Label="Global usings">
    <!--
      Namespaces that appeared in most files of both projects. Every project here either
      is OrderAggregationService or references it, which is what makes the two project
      namespaces safe to declare repository-wide. Anything used in only a handful of
      files stays an explicit using, so a reader can still see where a type comes from.
    -->
    <Using Include="Microsoft.Extensions.Options" />
    <Using Include="OrderAggregationService.Models" />
    <Using Include="OrderAggregationService.Services" />
  </ItemGroup>

  <PropertyGroup Label="Build quality">
    <!-- Our own code must build clean. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Exceptions for external tooling we do not control:
      NU1901-NU1904 are NuGet audit advisories raised by feed metadata, which can
      appear without any change to this repository and must not break the build.
      NETSDK1057 is emitted when building from a non-release SDK.
      CS1591 would require XML comments on every public member; documentation
      files are still generated so OpenAPI can pick up the comments we do write.
    -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904;NETSDK1057</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Reproducible builds">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EnableDefaultNoneItems>true</EnableDefaultNoneItems>
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <IsPackable>false</IsPackable>
    <Authors>vlastimilvajnorak</Authors>
    <Product>Order Aggregation Service</Product>
    <RepositoryUrl>https://github.com/vlastimilvajnorak/order-aggregation-service</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
