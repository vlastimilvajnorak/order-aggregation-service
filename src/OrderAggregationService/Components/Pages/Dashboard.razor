@page "/dashboard"
@rendermode InteractiveServer
@implements IAsyncDisposable

@using System.Globalization
@using Microsoft.Extensions.Diagnostics.HealthChecks

@inject IOrderAggregator Aggregator
@inject HealthCheckService HealthChecks
@inject IDispatchHistory History
@inject IJSRuntime JS

<PageTitle>Dashboard - Order Aggregation Service</PageTitle>

<div class="fill">

<div class="page-head">
    <div>
        <h1>Dashboard</h1>
        <p class="sub">
            Quantities accumulated since the last hand-over. A hand-over empties this list,
            so what left the service is shown below it.
        </p>
    </div>
    <div class="head-actions">
        <span class="state">
            <span class="dot @StatusModifier" aria-hidden="true"></span>@_healthStatus
        </span>
        <button type="button" class="button" @onclick="RefreshAsync" disabled="@(!RendererInfo.IsInteractive)">
            Refresh
        </button>
    </div>
</div>

<div class="stats">
    <div class="stat panel" title="Distinct product ids waiting for the next hand-over.">
        <span class="label">Products pending</span>
        <span class="value">@(_snapshot?.ProductCount ?? 0)</span>
    </div>
    <div class="stat panel" title="Sum of the quantities waiting for the next hand-over.">
        <span class="label">Units pending</span>
        <span class="value">@(_snapshot?.TotalQuantity ?? 0)</span>
    </div>
    <div class="stat panel" title="Requests accepted by POST /api/orders since startup. One request is one submitted JSON array, carrying one or more orders.">
        <span class="label">Requests accepted</span>
        <span class="value">@(_snapshot?.AcceptedRequestCount ?? 0)</span>
    </div>
    <div class="stat panel" title="Individual productId and quantity entries inside those requests, accepted since startup.">
        <span class="label">Orders accepted</span>
        <span class="value">@(_snapshot?.AcceptedOrderCount ?? 0)</span>
    </div>
</div>

<section class="panel handovers">
    <div class="panel-head">
        <h2>Recent hand-overs</h2>
        <span class="muted stamp">what already left the service</span>
    </div>
    @if (_dispatches.Count == 0)
    {
        <div class="panel-body muted">
            Nothing handed over yet. The first one follows within 20 seconds of the first order.
        </div>
    }
    else
    {
        <ul class="handover-list">
            @foreach (var dispatch in _dispatches.Take(5))
            {
                <li @key="dispatch.DispatchedAtUtc">
                    <span class="when">@(dispatch.DispatchedAtUtc.UtcDateTime.ToString("HH:mm:ss", CultureInfo.InvariantCulture))</span>
                    <span class="what"><strong>@dispatch.TotalQuantity</strong> units</span>
                    <span class="muted">/ @dispatch.ProductCount products</span>
                </li>
            }
        </ul>
    }
</section>

<section class="panel @(Total == 0 ? "compact" : null)" @ref="_panelElement">
    <div class="panel-head">
        <h2>Pending products</h2>
        <span class="muted stamp">@Stamp</span>
    </div>

    @if (Total == 0)
    {
        <div class="panel-body empty">
            <p class="muted">Nothing pending.</p>
            <p class="muted">
                Submit orders to <code>POST /api/orders</code>, or run the load generator, and it
                appears here until the next hand-over.
            </p>
        </div>
    }
    else
    {
        <div class="table-scroll">
        <table class="grid">
            <caption class="sr-only">Aggregated quantity per product</caption>
            <thead>
                <tr>
                    <th scope="col">Product</th>
                    <th scope="col" class="num">Quantity</th>
                    <th scope="col" class="num">Orders</th>
                    <th scope="col" class="num">Last updated</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in VisibleItems)
                {
                    <tr @key="item.ProductId">
                        <td><code>@item.ProductId</code></td>
                        <td class="num strong">@item.TotalQuantity</td>
                        <td class="num muted">@item.OrderCount</td>
                        <td class="num muted">@(item.LastUpdatedUtc.UtcDateTime.ToString("HH:mm:ss", CultureInfo.InvariantCulture))</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>

        <div class="pager">
            <span class="muted">@RangeLabel</span>
            <div class="pager-buttons">
                <button type="button" class="button" @onclick="PreviousPage" disabled="@(_page == 0)">
                    Previous
                </button>
                <span class="muted page-of">@($"{_page + 1} / {PageCount}")</span>
                <button type="button" class="button" @onclick="NextPage" disabled="@(_page + 1 >= PageCount)">
                    Next
                </button>
            </div>
        </div>
    }
</section>

</div>

@code {
    private const int DefaultPageSize = 25;
    private const int MinPageSize = 5;
    private const int MaxPageSize = 100;
    private const double FallbackRowHeight = 41;

    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(2);

    private readonly CancellationTokenSource _cancellation = new();

    private AggregationSnapshot? _snapshot;
    private IReadOnlyList<DispatchRecord> _dispatches = [];
    private HealthStatus _healthStatus = HealthStatus.Degraded;
    private PeriodicTimer? _timer;
    private Task? _refreshLoop;
    private int _page;
    private int _pageSize = DefaultPageSize;
    private ElementReference _panelElement;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Dashboard>? _self;

    private int Total => _snapshot?.Items.Count ?? 0;

    private int PageCount => Math.Max(1, (Total + _pageSize - 1) / _pageSize);

    private IEnumerable<AggregatedOrderItem> VisibleItems =>
        _snapshot is null ? [] : _snapshot.Items.Skip(_page * _pageSize).Take(_pageSize);

    private string RangeLabel =>
        Total == 0 ? string.Empty : $"{(_page * _pageSize) + 1}-{Math.Min((_page + 1) * _pageSize, Total)} of {Total}";

    private string Stamp => _snapshot is null
        ? string.Empty
        : $"Updated {_snapshot.GeneratedAtUtc.UtcDateTime.ToString("HH:mm:ss", CultureInfo.InvariantCulture)} UTC";

    private string StatusModifier => _healthStatus switch
    {
        HealthStatus.Healthy => "is-healthy",
        HealthStatus.Degraded => "is-degraded",
        _ => "is-unhealthy",
    };

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive)
        {
            _timer = new PeriodicTimer(RefreshInterval);
            _refreshLoop = RunRefreshLoopAsync();

            try
            {
                // The rows per page follow the viewport, so the table plus its pager always
                // fit the panel instead of overflowing on smaller windows.
                _module = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./Components/Pages/Dashboard.razor.js");
                _self = DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("observe", _self, _panelElement);
            }
            catch (JSDisconnectedException)
            {
                // The tab was closed or the circuit dropped between the first render and
                // this call. There is nothing left to measure, and letting it escape would
                // tear the circuit down and report a routine disconnect as a fault. The
                // default page size stays in effect.
            }
        }
    }

    /// <summary>
    /// Recomputes the page size from the measured panel geometry. Invoked from
    /// Dashboard.razor.js on start and, debounced, on every resize.
    /// </summary>
    /// <param name="panelHeight">Panel height, or 0 when the stacked layout is active.</param>
    /// <param name="rowHeight">Height of a rendered row, or 0 when the table is empty.</param>
    /// <param name="chromeHeight">Panel head, table header and pager combined.</param>
    [JSInvokable]
    public void OnViewportResized(double panelHeight, double rowHeight, double chromeHeight)
    {
        var next = DefaultPageSize;

        if (panelHeight > 0)
        {
            var row = rowHeight > 0 ? rowHeight : FallbackRowHeight;
            var fits = (int)Math.Floor((panelHeight - chromeHeight) / row);
            next = Math.Clamp(fits, MinPageSize, MaxPageSize);
        }

        if (next != _pageSize)
        {
            _pageSize = next;
            _page = Math.Clamp(_page, 0, PageCount - 1);
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _cancellation.CancelAsync();
        _timer?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unobserve", _panelElement);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone; the browser released the observer with it.
            }
        }

        _self?.Dispose();

        if (_refreshLoop is not null)
        {
            try
            {
                await _refreshLoop;
            }
            catch (OperationCanceledException)
            {
                // Expected while the component is being torn down.
            }
        }

        _cancellation.Dispose();
    }

    private void PreviousPage() => _page = Math.Max(0, _page - 1);

    private void NextPage() => _page = Math.Min(PageCount - 1, _page + 1);

    private async Task RunRefreshLoopAsync()
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync(_cancellation.Token))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected while the component is being torn down.
        }
    }

    private async Task RefreshAsync()
    {
        _snapshot = await Aggregator.GetSnapshotAsync(_cancellation.Token);
        _dispatches = History.GetRecent();

        // A hand-over empties the aggregate, so the current page can fall off the end.
        _page = Math.Clamp(_page, 0, PageCount - 1);

        var report = await HealthChecks.CheckHealthAsync(_cancellation.Token);
        _healthStatus = report.Status;
    }
}
