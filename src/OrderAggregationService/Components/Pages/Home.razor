@page "/"

<PageTitle>Order Aggregation Service</PageTitle>

<div class="page-head">
    <div>
        <h1>Overview</h1>
        <p class="sub">
            A .NET 10 service that accepts requests carrying one or more orders, sums the ordered
            quantity per product, and hands the totals to a downstream system no more often
            than once every 20 seconds.
        </p>
    </div>
    <div class="head-actions">
        <a class="button button-primary" href="dashboard">Open dashboard</a>
    </div>
</div>

<section class="panel">
    <div class="panel-head">
        <h2>Submit orders</h2>
        <span class="muted method">POST /api/orders</span>
    </div>
    <div class="panel-body">
        <p class="lead">
            The body is a JSON array. Every order needs a non-empty <code>productId</code> and a
            <code>quantity</code> greater than zero. A request is accepted or rejected as a whole.
        </p>
<pre><code>curl -X POST http://localhost:5212/api/orders \
  -H "Content-Type: application/json" \
  -d '[{"productId":"456","quantity":5},{"productId":"789","quantity":42}]'</code></pre>
        <p class="lead muted">
            The service answers <code>202 Accepted</code> with a receipt. Read the running totals
            back from <code>GET /api/orders/aggregates</code>, or watch them on the dashboard.
        </p>
    </div>
</section>

<div class="links">
    <a class="link-card panel" href="dashboard">
        <span class="link-title">Dashboard</span>
        <span class="link-sub">Live totals and service status</span>
    </a>
    <a class="link-card panel" href="api-docs">
        <span class="link-title">API reference</span>
        <span class="link-sub">Swagger UI over the OpenAPI document</span>
    </a>
    <a class="link-card panel" href="diagnostics">
        <span class="link-title">Diagnostics</span>
        <span class="link-sub">Health checks and current backlog</span>
    </a>
</div>
