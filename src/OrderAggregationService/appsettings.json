{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z'",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "OrderAggregation": {
    "DispatchEnabled": false,
    "DispatchInterval": "00:00:30",
    "MaxLinesPerRequest": 1000
  }
}
